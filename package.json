{
  "name": "devforge",
  "version": "0.1.0",
  "description": "AI-powered scaffolding CLI for microservices",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "devforge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "microservices",
    "scaffolding",
    "cli",
    "docker",
    "kubernetes",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "diff": "^5.2.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "minimatch": "^9.0.3",
    "mustache": "^4.2.0",
    "pino": "^8.18.0",
    "prompts": "^2.4.2",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/fs-extra": "^11.0.4",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.11.5",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^1.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
